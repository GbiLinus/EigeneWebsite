---
import '../styles/global.css';
import '../styles/intern.css';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import Logo from '../components/Logo.astro';
import { themeScript } from '../scripts/theme-inline';

interface Props {
  title: string;
  active?: 'home' | 'enquiries' | 'customers' | 'appointments' | 'password';
}

const { title, active } = Astro.props;

const nav = [
  { key: 'home', href: '/intern/', label: 'Übersicht', icon: 'M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z' },
  { key: 'enquiries', href: '/intern/anfragen/', label: 'Anfragen', icon: 'M4 13l2.5-8h11L20 13v6H4zM4 13h5l1 2h4l1-2h5', count: true },
  { key: 'customers', href: '/intern/kunden/', label: 'Kunden', icon: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 6.5M18 14a6.5 6.5 0 0 1 3.5 6' },
  { key: 'appointments', href: '/intern/termine/', label: 'Termine', icon: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4' },
] as const;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – WebDesignBR intern</title>
    <meta name="theme-color" content="#041b20" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={themeScript} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/intern.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="WDBR intern" />
  </head>
  <body
    class="intern"
    data-url-login="/anmelden/"
    data-url-home="/intern/"
    data-url-enquiries="/intern/anfragen/"
    data-url-customers="/intern/kunden/"
    data-url-password="/intern/passwort/"
  >
    <div class="scene" aria-hidden="true">
      <div class="blob blob-sole"></div>
      <div class="blob blob-abend"></div>
    </div>

    <p class="boot">Anmeldung wird geprüft</p>

    <div class="no-access glass" data-no-access hidden>
      <h1 class="page-title">Kein Zugriff</h1>
      <p class="page-sub">Dieses Konto ist nicht als Mitarbeiter eingetragen. Meldet euch mit eurem WebDesignBR-Konto an.</p>
      <button class="btn-s" type="button" data-logout>Abmelden</button>
    </div>

    <div class="shell" data-app>
      <aside class="side glass glass-bar">
        <a class="side-brand" href="/intern/">
          <Logo />
          <span class="side-sub">Intern</span>
        </a>
        <nav class="side-nav" aria-label="Bereiche">
          {
            nav.map((n) => (
              <a class="nav-item" href={n.href} aria-current={active === n.key ? 'page' : undefined}>
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={n.icon} />
                </svg>
                {n.label}
                {'count' in n && <span class="count" data-new-count hidden></span>}
              </a>
            ))
          }
        </nav>
        <div class="side-foot">
          <p class="me" data-me></p>
          <div class="side-theme">
            <ThemeSwitch lang="de" />
          </div>
          <a class="link-btn" href="/intern/passwort/" aria-current={active === 'password' ? 'page' : undefined}>Passwort ändern</a>
          <a class="link-btn" href="/">Zur Website</a>
          <button class="link-btn" type="button" data-logout>Abmelden</button>
        </div>
      </aside>

      <header class="topbar glass glass-bar">
        <a class="side-brand" href="/intern/">
          <Logo />
          <span class="side-sub">Intern</span>
        </a>
        <a class="me" href="/intern/passwort/" data-me aria-label="Konto und Passwort"></a>
      </header>

      <main class="main" id="main">
        <p class="demo-banner">Demo-Modus: Beispieldaten, nur in diesem Browser gespeichert. Sobald Supabase eingetragen ist, arbeitet ihr hier mit echten Daten.</p>
        <slot />
      </main>

      <nav class="tabbar glass glass-bar" aria-label="Bereiche">
        {
          nav.map((n) => (
            <a class="nav-item" href={n.href} aria-current={active === n.key ? 'page' : undefined}>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={n.icon} />
              </svg>
              {n.label}
              {'count' in n && <span class="count" data-new-count hidden></span>}
            </a>
          ))
        }
      </nav>
    </div>

    <script>
      import '../scripts/theme';
      import { ready, setNewCount } from '../intern/app';

      // Anzahl neuer Anfragen für die Navigation
      ready().then(async ({ store, session }) => {
        if (!session.staff) return;
        const list = await store.enquiries().catch(() => []);
        setNewCount(list.filter((e) => e.status === 'neu').length);
      });
    </script>
  </body>
</html>
