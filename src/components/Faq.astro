---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="section faq" id={d.ids.faq}>
  <div class="container faq-layout">
    <header class="section-head">
      <h2 class="t-h2">{d.faq.title}</h2>
    </header>

    <div class="faq-list">
      {
        d.faq.items.map((item) => (
          <details class="faq-item" data-faq>
            <summary>
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-body">
              <p class="t-body">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    font-weight: 620;
    font-stretch: 106%;
    letter-spacing: -0.01em;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(237 246 243 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(237 246 243 / 0.12);
    transition:
      transform 0.6s var(--ease-liquid),
      background-color 0.3s;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.8rem;
    height: 1.5px;
    margin: -0.75px 0 0 -0.4rem;
    border-radius: 2px;
    background: var(--salz);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  summary:hover .faq-icon {
    background: rgb(237 246 243 / 0.12);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(135deg);
    background: var(--sole);
  }

  .faq-item[open] .faq-icon::before,
  .faq-item[open] .faq-icon::after {
    background: var(--nacht);
  }

  .faq-body {
    overflow: hidden;
  }

  .faq-body p {
    padding: 0 3.5rem 1.75rem 0;
  }

  @media (max-width: 860px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }
    .faq-body p {
      padding-right: 0;
    }
  }
</style>

<script>
  import { gsap, reduced } from '../scripts/motion';

  // Weiches Auf- und Zuklappen, Inhalt bleibt ohne JS normal nutzbar
  document.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((el) => {
    const summary = el.querySelector('summary')!;
    const body = el.querySelector<HTMLElement>('.faq-body')!;
    summary.addEventListener('click', (e) => {
      if (reduced) return;
      e.preventDefault();
      if (el.open) {
        gsap.to(body, {
          height: 0,
          opacity: 0,
          duration: 0.45,
          ease: 'power3.inOut',
          onComplete: () => {
            el.open = false;
            gsap.set(body, { clearProps: 'height,opacity' });
          },
        });
      } else {
        el.open = true;
        gsap.fromTo(body, { height: 0, opacity: 0 }, { height: 'auto', opacity: 1, duration: 0.6, ease: 'power3.out' });
      }
    });
  });
</script>
