---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="hero" id="top" data-hero>
  <div class="hero-layout" data-hero-layout>
    <canvas class="hero-strands" data-strands-bg aria-hidden="true"></canvas>
    <canvas class="hero-strands" data-strands aria-hidden="true"></canvas>
    <div class="hero-inner container">
      <h1 class="t-display hero-title">
        {
          d.hero.lines.map((line) => (
            <span class="hero-mask">
              <span class="hero-line">{line}</span>
            </span>
          ))
        }
      </h1>
      <p class="t-lead hero-lead" data-intro-fade>{d.hero.lead}</p>
      <div class="hero-ctas" data-intro-fade>
        <a class="btn btn-primary" href={`#${d.ids.contact}`} data-magnetic>{d.hero.primary}</a>
        <a class="btn btn-ghost glass" href={`#${d.ids.pricing}`} data-spec>{d.hero.secondary}</a>
      </div>
    </div>
  </div>

  <div class="lens" data-lens aria-hidden="true">
    <div class="lens-pop" data-lens-pop>
      <div class="lens-inner" data-lens-inner></div>
      <div class="lens-shine"></div>
    </div>
  </div>

  <p class="hero-egg" data-egg data-text={`★★★★★ ${d.lensHint}`} role="status" aria-live="polite"></p>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-layout {
    position: relative;
    display: grid;
    align-items: center;
    min-height: max(40rem, min(100svh, 62rem));
    padding-block: 8rem 5rem;
  }

  .hero-strands {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent 22%, #000 62%);
    mask-image: linear-gradient(90deg, transparent 22%, #000 62%);
  }

  .hero-inner {
    position: relative;
  }

  .hero-title {
    display: grid;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .hero-mask {
    display: block;
    overflow: hidden;
    /* Platz für Unterlängen innerhalb der Maske */
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero-line {
    display: block;
    width: fit-content;
  }

  .hero-mask:nth-child(2) .hero-line {
    background: linear-gradient(100deg, var(--salz) 10%, #a8f3e7 45%, #c9c1ff 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    max-width: 31em;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Intro-Startzustand, nur mit JS und ohne reduzierte Bewegung */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-layout[data-hero-layout] .hero-line {
      transform: translateY(108%);
      animation: hero-fallback 0s 2.6s forwards;
    }
    :global(.js) .hero-layout[data-hero-layout] [data-intro-fade],
    :global(.js) .hero-layout[data-hero-layout] .hero-strands {
      opacity: 0;
      animation: hero-fallback 0s 2.6s forwards;
    }
  }

  @keyframes hero-fallback {
    to {
      transform: none;
      opacity: 1;
    }
  }

  /* ---------------- Linse ---------------- */
  .lens {
    --size: clamp(8.5rem, 17vw, 15rem);
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: var(--size);
    height: var(--size);
    pointer-events: none;
    will-change: transform;
    visibility: hidden;
  }

  .lens.is-ready {
    visibility: visible;
  }

  .lens-pop {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    transform: scale(0);
    background: radial-gradient(circle at 50% 60%, var(--tiefsole), var(--nacht));
    box-shadow:
      0 30px 60px -18px rgb(0 8 10 / 0.85),
      0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .lens-inner {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
  }

  /* Verzerrung am Rand: chromatische Aberration im Klon */
  .lens-inner :global(.hero-line),
  .lens-inner :global(.hero-lead),
  .lens-inner :global(.btn) {
    filter: drop-shadow(-1.5px 0 rgb(255 90 140 / 0.4)) drop-shadow(1.5px 0 rgb(80 210 255 / 0.45));
  }

  .lens-shine {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(circle at 32% 22%, rgb(255 255 255 / 0.45), transparent 26%),
      radial-gradient(circle at 70% 85%, rgb(59 227 201 / 0.28), transparent 30%),
      radial-gradient(circle, transparent 58%, rgb(255 255 255 / 0.08) 66%, rgb(255 255 255 / 0.22) 71%, transparent 72%);
    box-shadow:
      inset 0 2px 1px rgb(255 255 255 / 0.55),
      inset 0 -3px 8px rgb(59 227 201 / 0.35),
      inset 0 0 22px rgb(255 255 255 / 0.12),
      inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }

  @media (hover: none), (pointer: coarse) {
    .lens {
      pointer-events: auto;
      touch-action: none;
      cursor: grab;
    }
  }

  .hero-egg {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    z-index: 3;
    margin: 0;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--nacht);
    background: var(--gold);
    box-shadow: 0 10px 30px -6px rgb(255 194 75 / 0.6);
    transform: translate(-50%, 1rem);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-liquid);
  }

  .hero-egg.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 700px) {
    .hero-strands {
      opacity: 0.55;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 70%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 70%, transparent 100%);
    }
    .hero-layout {
      min-height: 100svh;
      padding-block: 7rem 4rem;
    }
  }
</style>

<script>
  import { gsap, reduced, finePointer } from '../scripts/motion';

  type Drop = { x: number; y: number; v: number; pause: number; len: number; size: number; glow: number };

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHero(hero);

  function initHero(hero: HTMLElement) {
    const layout = hero.querySelector<HTMLElement>('[data-hero-layout]')!;
    const bg = layout.querySelector<HTMLCanvasElement>('[data-strands-bg]')!;
    const canvas = layout.querySelector<HTMLCanvasElement>('[data-strands]')!;
    const title = layout.querySelector<HTMLElement>('.hero-title')!;
    const lens = hero.querySelector<HTMLElement>('[data-lens]')!;
    const pop = lens.querySelector<HTMLElement>('[data-lens-pop]')!;
    const inner = lens.querySelector<HTMLElement>('[data-lens-inner]')!;

    // Klon des Hero-Inhalts für die Linse
    const clone = layout.cloneNode(true) as HTMLElement;
    clone.removeAttribute('data-hero-layout');
    clone.setAttribute('inert', '');
    clone.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
    clone.querySelectorAll('[data-magnetic]').forEach((el) => el.removeAttribute('data-magnetic'));
    const lensBg = clone.querySelector<HTMLCanvasElement>('[data-strands-bg]')!;
    const lensCanvas = clone.querySelector<HTMLCanvasElement>('[data-strands]')!;
    lensBg.removeAttribute('data-strands-bg');
    lensCanvas.removeAttribute('data-strands');
    inner.appendChild(clone);

    // Schwächere Geräte: halbe Bildrate, weniger Tropfen, einfache Pixeldichte
    const small = window.matchMedia('(max-width: 700px)').matches;
    const lowPower = small || !finePointer || (navigator.hardwareConcurrency ?? 8) <= 4;

    const bctx = bg.getContext('2d')!;
    const ctx = canvas.getContext('2d')!;
    const lbctx = lensBg.getContext('2d')!;
    const lctx = lensCanvas.getContext('2d')!;
    let W = 0;
    let H = 0;
    let dpr = 1;
    let drops: Drop[] = [];
    let starMode = false;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const startX = () => (W < 700 ? 0 : W * 0.3);

    // ---------------- Vorgerenderte Bausteine ----------------
    const makeSprite = (w: number, h: number, paint: (c: CanvasRenderingContext2D) => void) => {
      const c = document.createElement('canvas');
      c.width = w;
      c.height = h;
      paint(c.getContext('2d')!);
      return c;
    };

    const head = makeSprite(32, 32, (c) => {
      const g = c.createRadialGradient(16, 16, 0, 16, 16, 16);
      g.addColorStop(0, 'rgba(237,246,243,1)');
      g.addColorStop(0.18, 'rgba(237,246,243,0.95)');
      g.addColorStop(0.3, 'rgba(59,227,201,0.35)');
      g.addColorStop(1, 'rgba(59,227,201,0)');
      c.fillStyle = g;
      c.fillRect(0, 0, 32, 32);
    });

    const trail = makeSprite(4, 64, (c) => {
      const g = c.createLinearGradient(0, 0, 0, 64);
      g.addColorStop(0, 'rgba(59,227,201,0)');
      g.addColorStop(1, 'rgba(59,227,201,0.55)');
      c.fillStyle = g;
      c.fillRect(0, 0, 4, 64);
    });

    const star = makeSprite(32, 32, (c) => {
      c.fillStyle = 'rgba(255,194,75,0.95)';
      c.beginPath();
      for (let i = 0; i < 10; i++) {
        const a = -Math.PI / 2 + (i * Math.PI) / 5;
        const r = i % 2 === 0 ? 15 : 6.5;
        c.lineTo(16 + Math.cos(a) * r, 16 + Math.sin(a) * r);
      }
      c.closePath();
      c.fill();
    });

    // ---------------- Gradierwerk: Reisig (einmal gezeichnet) ----------------
    function paintBackground() {
      bctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      bctx.clearRect(0, 0, W, H);
      bctx.lineCap = 'round';
      const x0 = startX();
      for (let x = x0; x < W + 10; x += rand(2.5, 6)) {
        const lean = rand(-0.05, 0.05);
        const top = rand(-20, H * 0.08);
        const alpha = rand(0.04, 0.15);
        bctx.strokeStyle = `rgba(237,246,243,${alpha})`;
        bctx.lineWidth = rand(0.5, 1.3);
        bctx.beginPath();
        bctx.moveTo(x, top);
        for (let i = 1; i <= 9; i++) {
          const y = top + ((H + 40 - top) * i) / 9;
          bctx.lineTo(x + lean * (y - top) + rand(-1.4, 1.4), y);
        }
        bctx.stroke();
        // kurze Seitenzweige wie beim Schwarzdorn-Reisig
        if (Math.random() < 0.35) {
          const by = rand(top, H);
          const bx = x + lean * (by - top);
          bctx.strokeStyle = `rgba(237,246,243,${alpha * 0.7})`;
          bctx.beginPath();
          bctx.moveTo(bx, by);
          bctx.lineTo(bx + rand(-9, 9), by + rand(6, 16));
          bctx.stroke();
        }
      }
      // Holzrahmen des Gradierwerks: zwei feine Querbalken
      bctx.strokeStyle = 'rgba(237,246,243,0.05)';
      bctx.lineWidth = 1;
      [0.34, 0.68].forEach((f) => {
        bctx.beginPath();
        bctx.moveTo(x0, H * f);
        bctx.lineTo(W, H * f);
        bctx.stroke();
      });
      lbctx.clearRect(0, 0, lensBg.width, lensBg.height);
      lbctx.drawImage(bg, 0, 0);
    }

    function makeDrop(initial: boolean): Drop {
      return {
        x: rand(startX(), W),
        y: initial ? rand(-H * 0.2, H) : rand(-H * 0.3, -10),
        v: rand(10, 40),
        pause: Math.random() < 0.3 ? rand(0, 1.2) : 0,
        len: rand(14, 48),
        size: rand(0.8, 2.2),
        glow: Math.random() < 0.25 ? 1 : rand(0.35, 0.7),
      };
    }

    // Geometrie nur bei Größenänderung messen, nicht in jedem Frame
    const geo = { left: 0, top: 0, textW: 0, h: 0 };
    function measure() {
      const hr = hero.getBoundingClientRect();
      const tr = title.getBoundingClientRect();
      geo.left = tr.left - hr.left;
      geo.top = tr.top - hr.top;
      geo.h = tr.height;
      geo.textW = Math.max(...[...title.querySelectorAll('.hero-line')].map((l) => l.getBoundingClientRect().width));
    }

    function resize() {
      const r = layout.getBoundingClientRect();
      W = Math.round(r.width);
      H = Math.round(r.height);
      dpr = lowPower ? 1 : Math.min(window.devicePixelRatio || 1, 1.5);
      for (const c of [bg, canvas, lensBg, lensCanvas]) {
        c.width = W * dpr;
        c.height = H * dpr;
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      inner.style.width = `${W}px`;
      inner.style.height = `${H}px`;
      paintBackground();
      const count = Math.round(Math.min(lowPower ? 36 : 64, W / 22));
      drops = Array.from({ length: count }, () => makeDrop(true));
      measure();
    }

    function step(dt: number) {
      for (const d of drops) {
        if (d.pause > 0) d.pause -= dt;
        else {
          d.v = Math.min(d.v + 28 * dt, 120);
          d.y += d.v * dt;
          // Oberflächenspannung: Tropfen bleiben manchmal kurz hängen
          if (Math.random() < dt * 0.25) {
            d.pause = rand(0.3, 1.4);
            d.v = rand(6, 18);
          }
        }
        if (d.y - d.len > H) Object.assign(d, makeDrop(false));
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      for (const d of drops) {
        ctx.globalAlpha = starMode ? 1 : d.glow;
        const w = Math.max(1, d.size * 0.9);
        ctx.drawImage(trail, d.x - w / 2, d.y - d.len, w, d.len);
        const s = d.size * (starMode ? 4 : 3.4);
        ctx.drawImage(starMode ? star : head, d.x - s, d.y - s, s * 2, s * 2);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    // Nur den Ausschnitt unter der Linse in den Klon kopieren
    function copyToLens() {
      const rr = (R / MAG) * 1.3 + 6;
      const cx = pos.x + R;
      const cy = pos.y + R;
      const sx = Math.max(0, Math.floor((cx - rr) * dpr));
      const sy = Math.max(0, Math.floor((cy - rr) * dpr));
      const sw = Math.min(canvas.width - sx, Math.ceil(rr * 2 * dpr));
      const sh = Math.min(canvas.height - sy, Math.ceil(rr * 2 * dpr));
      if (sw <= 0 || sh <= 0) return;
      lctx.clearRect(sx, sy, sw, sh);
      lctx.drawImage(canvas, sx, sy, sw, sh, sx, sy, sw, sh);
    }

    // ---------------- Linse ----------------
    let R = lens.offsetWidth / 2;
    const MAG = 1.42;
    const pos = { x: 0, y: 0, tx: 0, ty: 0, vx: 0, vy: 0 };
    let mode: 'idle' | 'follow' | 'drag' = 'idle';
    let idleT = Math.random() * 10;
    let idleTimer = 0;
    let lensVisible = false;
    let heroVisible = true;
    let acc = 0;

    function idleTarget() {
      const w = Math.max(geo.textW - 2 * R, 0);
      const h = Math.max(geo.h - 2 * R, 0);
      pos.tx = geo.left + w * (0.5 + 0.48 * Math.sin(idleT * 0.32));
      pos.ty = geo.top + h * (0.5 + 0.5 * Math.sin(idleT * 0.53 + 1.3));
    }

    function applyLens() {
      const speed = Math.hypot(pos.vx, pos.vy);
      const stretch = reduced ? 0 : Math.min(speed / 2600, 0.16);
      const ang = Math.atan2(pos.vy, pos.vx);
      lens.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0) rotate(${ang}rad) scale(${1 + stretch}, ${1 - stretch * 0.75}) rotate(${-ang}rad)`;
      inner.style.transformOrigin = `${pos.x + R}px ${pos.y + R}px`;
      inner.style.transform = `translate3d(${-pos.x}px, ${-pos.y}px, 0) scale(${MAG})`;
    }

    function tick(_time: number, deltaMs: number) {
      if (!heroVisible || document.hidden) return;
      const dt = Math.min(deltaMs / 1000, 0.05);

      // Tropfen: auf schwachen Geräten nur jedes zweite Bild zeichnen
      acc += dt;
      if (!lowPower || acc >= 1 / 30) {
        step(acc);
        acc = 0;
        draw();
        if (lensVisible) copyToLens();
      }

      if (!lensVisible) return;
      if (mode === 'idle') {
        idleT += dt;
        idleTarget();
      }
      const k = 1 - Math.exp(-dt * (mode === 'drag' ? 18 : 6.5));
      const nx = pos.x + (pos.tx - pos.x) * k;
      const ny = pos.y + (pos.ty - pos.y) * k;
      pos.vx = dt > 0 ? (nx - pos.x) / dt : 0;
      pos.vy = dt > 0 ? (ny - pos.y) / dt : 0;
      pos.x = nx;
      pos.y = ny;
      applyLens();
    }

    const toIdleLater = (ms: number) => {
      clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => (mode = 'idle'), ms);
    };

    if (finePointer && !reduced) {
      hero.addEventListener('pointermove', (e) => {
        const hr = hero.getBoundingClientRect();
        mode = 'follow';
        pos.tx = e.clientX - hr.left - R;
        pos.ty = e.clientY - hr.top - R;
        toIdleLater(4000);
      });
      hero.addEventListener('pointerleave', () => toIdleLater(600));
    }

    if (!finePointer && !reduced) {
      let offX = 0;
      let offY = 0;
      lens.addEventListener('pointerdown', (e) => {
        lens.setPointerCapture(e.pointerId);
        mode = 'drag';
        const hr = hero.getBoundingClientRect();
        offX = e.clientX - hr.left - pos.x;
        offY = e.clientY - hr.top - pos.y;
        clearTimeout(idleTimer);
      });
      lens.addEventListener('pointermove', (e) => {
        if (mode !== 'drag') return;
        const hr = hero.getBoundingClientRect();
        pos.tx = e.clientX - hr.left - offX;
        pos.ty = e.clientY - hr.top - offY;
      });
      const end = () => {
        if (mode === 'drag') toIdleLater(2500);
      };
      lens.addEventListener('pointerup', end);
      lens.addEventListener('pointercancel', end);
    }

    new IntersectionObserver(([entry]) => (heroVisible = entry.isIntersecting)).observe(hero);

    let resizeTimer = 0;
    let lastW = window.innerWidth;
    window.addEventListener('resize', () => {
      // Mobile Browser feuern resize beim Ein- und Ausblenden der Adressleiste
      if (window.innerWidth === lastW && lowPower) return;
      lastW = window.innerWidth;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        R = lens.offsetWidth / 2;
        resize();
        draw();
        if (reduced) placeStatic();
        lctx.clearRect(0, 0, lensCanvas.width, lensCanvas.height);
        lctx.drawImage(canvas, 0, 0);
      }, 150);
    });
    document.fonts?.ready.then(measure);

    function placeStatic() {
      const hr = hero.getBoundingClientRect();
      const line = title.querySelectorAll('.hero-line')[1] ?? title;
      const lr = line.getBoundingClientRect();
      pos.x = pos.tx = lr.left - hr.left + lr.width * 0.62 - R;
      pos.y = pos.ty = lr.top - hr.top + lr.height / 2 - R;
      applyLens();
    }

    resize();
    draw();

    // ---------------- Intro ----------------
    const showLens = () => {
      lctx.clearRect(0, 0, lensCanvas.width, lensCanvas.height);
      lctx.drawImage(canvas, 0, 0);
      lensVisible = true;
      lens.classList.add('is-ready');
    };

    if (reduced) {
      showLens();
      pop.style.transform = 'scale(1)';
      placeStatic();
      return;
    }

    idleTarget();
    pos.x = pos.tx;
    pos.y = pos.ty;
    applyLens();
    gsap.ticker.add(tick);

    const lines = layout.querySelectorAll('.hero-line');
    const fades = layout.querySelectorAll('[data-intro-fade]');
    gsap
      .timeline({ defaults: { ease: 'expo.out' } })
      .to([bg, canvas], { opacity: 1, duration: 2, ease: 'power1.out' }, 0)
      .to(lines, { y: 0, yPercent: 0, duration: 1.3, stagger: 0.13 }, 0.1)
      .fromTo(fades, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 1.1, stagger: 0.12 }, 0.55)
      .add(showLens, 1.05)
      .fromTo(pop, { scale: 0 }, { scale: 1, duration: 1.4, ease: 'elastic.out(1, 0.5)' }, 1.05);

    // ---------------- Easter Egg: Konami-Code ----------------
    const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let idx = 0;
    const egg = hero.querySelector<HTMLElement>('[data-egg]')!;
    let eggTimer = 0;
    window.addEventListener('keydown', (e) => {
      idx = e.key.toLowerCase() === code[idx].toLowerCase() ? idx + 1 : e.key === code[0] ? 1 : 0;
      if (idx === code.length) {
        idx = 0;
        starMode = true;
        egg.textContent = egg.dataset.text ?? '';
        egg.classList.add('is-on');
        clearTimeout(eggTimer);
        eggTimer = window.setTimeout(() => {
          starMode = false;
          egg.classList.remove('is-on');
          egg.textContent = '';
        }, 9000);
      }
    });
  }
</script>
