# Supabase steht in src/config/site.ts. Diese Werte sind nur nötig, um ein
# anderes Projekt zu nutzen. Nur den Publishable Key eintragen, niemals den
# Secret- oder service_role-Key.
# PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# PUBLIC_SUPABASE_KEY=sb_publishable_xxxx

# Nur für Vorschau-Builds ohne Supabase: Demo-Modus mit Beispieldaten im
# Browser. Live nie setzen, sonst landen Anfragen nur lokal beim Besucher.
# PUBLIC_DEMO=true
